{
  "name": "fie-api-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FIE API Portal Monorepo with Portal and Admin apps",
  "workspaces": [
    "apps/portal",
    "apps/admin",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:portal dev:admin",
    "dev:portal": "npm -w @fie-api/portal run dev",
    "dev:admin": "npm -w @fie-api/admin run dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  }
}
